{
  "version": "1.7.0",
  "name": "banana-fusion",
  "private": true,
  "description": "Banana for Solr - A Port of Kibana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucidworks/banana.git"
  },
  "homepage": "https://github.com/lucidworks/banana",
  "bugs": {
    "url": "https://github.com/lucidworks/banana/issues"
  },
  "license": "Apache-2.0",
  "author": "Lucidworks, Inc. and Banana contributors",
  "contributors": [
    {
      "name": "Banana contributors",
      "url": "https://github.com/lucidworks/banana/graphs/contributors"
    }
  ],
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@playwright/test": "1.65.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-angularjs-annotate": "^0.10.0",
    "babel-plugin-istanbul": "^8.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "http-server": "^14.1.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-webpack": "5.0.0",
    "license-webpack-plugin": "^4.0.2",
    "playwright": "1.65.0",
    "style-loader": "^4.0.0",
    "vis": "4.21.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "x2js": "^3.4.5"
  },
  "scripts": {
    "prepack": "npm run build",
    "prestart": "node -e \"require('fs').existsSync('dist/index.html') || (console.error('dist/ is missing: run npm run build first'), process.exit(1))\"",
    "start": "http-server dist -a 0.0.0.0 -p 8000",
    "build": "webpack --mode production && node tools/check-dist.js",
    "dev": "webpack serve --mode development",
    "check:dist": "node tools/check-dist.js",
    "check:lockfile": "node tools/check-lockfile.js",
    "smoke": "node tools/smoke.js",
    "test:hostile": "node tools/hostile.js",
    "test": "karma start test/karma.conf.js --single-run",
    "test:coverage": "karma start test/karma.coverage.conf.js --single-run",
    "test:watch": "karma start test/karma.conf.js --no-single-run --auto-watch",
    "test:node": "node --test \"test/node/**/*.test.js\"",
    "fusion-it-setup": "node scripts/fusion-it-setup",
    "test:image": "docker build -t banana-hosting:dev . && node --test \"test/node/image/*.test.js\"",
    "test:live": "node test/live/fusion-client/launcher.js",
    "test:live:check": "node test/live/fusion-client/source-check.js",
    "test:live:orphans": "node test/live/fusion-client/cli.js orphans",
    "test:live-local": "node --test --test-concurrency=1 \"test/live-local/**/*.test.js\""
  },
  "dependencies": {}
}
